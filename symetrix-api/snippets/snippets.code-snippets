  "HTTP": {
    "prefix": "HTTP Framework",
    "body": [
      "json = require(\"json\")",
      "",
      "function Response(Table, ReturnCode, Data, Error, Headers)",
      "    if (200 == ReturnCode) then",
      "        -- Handle the response (use json.decode(Data) for JSON)",
      "        $0",
      "    else",
      "        print(string.format(\"Failed: %s, code #%s, '%s'\", Table.Url, tostring(ReturnCode), tostring(Error)))",
      "    end",
      "end",
      "",
      "function Http_Request()",
      "    local url = HttpClient.CreateUrl({",
      "        Host = \"${1:http://host}\",",
      "        Path = \"${2:path}\" })",
      "",
      "    HttpClient.Upload({",
      "        Url = url,",
      "        Headers = { [\"Content-Type\"] = \"application/json\" },",
      "        Data = json.encode({ ${3:key = \"value\"} }),",
      "        Method = \"POST\",",
      "        Timeout = 5,",
      "        EventHandler = Response })",
      "",
      "    HttpClient.Download({",
      "        Url = url,",
      "        Timeout = 5,",
      "        EventHandler = Response })",
      "end"
    ],
    "description": "HTTP framework: shared response callback plus CreateUrl, Upload and Download."
  },
