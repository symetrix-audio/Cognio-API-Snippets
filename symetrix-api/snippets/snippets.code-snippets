  "Timer One-Shot": {
    "prefix": [
      "Timer One-Shot",
      "Timer Delay"
    ],
    "body": [
      "function ${1:DelayedAction}()",
      "    ${1:DelayedAction}Timer:Stop()",
      "    $0",
      "end",
      "",
      "${1:DelayedAction}Timer = Timer.New()",
      "${1:DelayedAction}Timer.EventHandler = ${1:DelayedAction}",
      "${1:DelayedAction}Timer:Start(${2:10})"
    ],
    "description": "One-shot timer: runs the callback once after a delay, then stops itself."
  },
  "Timer Multiplier Framework": {
    "prefix": [
      "Timer Multiplier Framework",
      "Timer Fast/Slow Framework"
    ],
    "body": [
      "timerMultiplier = ${1:10}",
      "timerCounter = 0",
      "",
      "function TimerClick()",
      "    -- Do fast work every tick",
      "    $0",
      "",
      "    timerCounter = timerCounter + 1",
      "    if timerCounter >= timerMultiplier then",
      "        timerCounter = 0",
      "        -- Do slow work every timerMultiplier ticks",
      "    end",
      "end",
      "",
      "MyTimer = Timer.New()",
      "MyTimer.EventHandler = TimerClick",
      "MyTimer:Start(${2:0.25})"
    ],
    "description": "One fast timer with a counter for slower work - more efficient than creating several timers."
  },
