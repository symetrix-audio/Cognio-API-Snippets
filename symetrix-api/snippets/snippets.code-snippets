  "Controls Framework": {
    "prefix": "Controls Framework",
    "body": [
      "function PinChanged()",
      "    local state1 = Controls.Inputs[1].Value",
      "    local state2 = Controls.Inputs[2].Value",
      "",
      "    if (state1 > 0.5) and (state2 > 0.5) then",
      "        Controls.Outputs[1].Value = 1.0",
      "    else",
      "        Controls.Outputs[1].Value = 0.0",
      "    end$0",
      "end",
      "",
      "Controls.Inputs[1].EventHandler = PinChanged",
      "Controls.Inputs[2].EventHandler = PinChanged"
    ],
    "description": "Controls framework: shared input pin EventHandler that drives an output pin."
