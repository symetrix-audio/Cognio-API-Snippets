{
  "Timer": {
    "prefix": [
      "Timer",
      "Timer Framework"
    ],
    "body": [
      "function TimerClick()",
      "    $0",
      "end",
      "",
      "MyTimer = Timer.New()",
      "MyTimer.EventHandler = TimerClick",
      "MyTimer:Start(${1:0.25})"
    ],
    "description": "Timer framework: callback function, Timer.New, EventHandler and Start. Timers run at most 4 Hz (0.25 s minimum)."
  },
