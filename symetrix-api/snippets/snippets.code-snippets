  "NamedControl Framework": {
    "prefix": [
      "NamedControl Framework",
      "NamedControl Subscribe Framework"
    ],
    "body": [
      "-- Event-driven control handling - no polling timer needed.",
      "-- Don't call NamedControl.GetChanged on a subscribed control; they share one changed flag.",
      "NamedControl.EventHandler = function(controlName, value)",
      "    -- value is always passed as a string",
      "    if controlName == \"${1:MyButton}\" then",
      "        if tonumber(value) == 1 then",
      "            $0",
      "        end",
      "    elseif controlName == \"${2:MyFader}\" then",
      "        NamedControl.SetValue(\"${3:MyMeter}\", tonumber(value))",
      "    end",
      "end",
      "",
      "NamedControl.SubscribeText(\"${1:MyButton}\")",
      "NamedControl.SubscribeText(\"${2:MyFader}\")"
    ],
    "description": "NamedControl framework: SubscribeText plus a single EventHandler for event-driven scripts."
  },
  "NamedControl Polling Framework": {
    "prefix": "NamedControl Polling Framework",
    "body": [
      "function TimerClick()",
      "    if NamedControl.GetChanged(\"${1:MyFader}\") == 1 then",
      "        local value = NamedControl.GetValue(\"${1:MyFader}\")",
      "        $0",
      "    end",
      "end",
      "",
      "MyTimer = Timer.New()",
      "MyTimer.EventHandler = TimerClick",
      "MyTimer:Start(${2:0.25})"
    ],
    "description": "Polling framework: a Timer that uses NamedControl.GetChanged to act only when a control changes."
  },
  "NamedControl Latching Button": {
    "prefix": "NamedControl Latching Button",
    "body": [
      "if NamedControl.GetValue(\"${1:MyButton}\") == 1 then",
