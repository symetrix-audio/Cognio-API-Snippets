  "TCP Driver Framework": {
    "prefix": [
      "TCP Driver Framework",
      "Driver Framework"
    ],
    "body": [
      "-- ${1:Device} TCP control driver",
      "-- Control Panel controls (Script Names): \"${2:IPAddress}\" (Label), \"${3:Connected}\" (LED), \"${4:Power}\" (Button)",
      "",
      "port = ${5:23}",
      "connectedIp = \"\"",
      "",
      "sock = TcpSocket.New()",
      "sock.ReconnectTimeout = 5",
      "",
      "sock.Connected = function()",
      "    NamedControl.SetValue(\"${3:Connected}\", 1)",
      "end",
      "",
      "sock.Closed = function()",
      "    NamedControl.SetValue(\"${3:Connected}\", 0)",
      "end",
      "",
      "sock.Error = function(s, err)",
      "    NamedControl.SetValue(\"${3:Connected}\", 0)",
      "    print(string.format(\"Error: '%s'\", err))",
      "end",
      "",
      "sock.Timeout = function(s, err)",
      "    print(\"Timeout\")",
      "end",
      "",
      "sock.Data = function()",
      "    local line = sock:ReadLine(TcpSocket.EOL.Any)",
      "    while line do",
      "        -- Parse device feedback and update controls",
      "        $0",
      "        line = sock:ReadLine(TcpSocket.EOL.Any)",
      "    end",
      "end",
      "",
      "function Connect()",
      "    local ip = NamedControl.GetText(\"${2:IPAddress}\")",
      "    if ip ~= nil and ip ~= \"\" and ip ~= connectedIp then",
      "        if sock.IsConnected then",
      "            sock:Disconnect()",
      "        end",
      "        connectedIp = ip",
      "        sock:Connect(ip, port)",
      "    end",
      "end",
      "",
      "NamedControl.EventHandler = function(controlName, value)",
      "    if controlName == \"${2:IPAddress}\" then",
      "        Connect()",
      "    elseif controlName == \"${4:Power}\" then",
      "        if sock.IsConnected then",
      "            sock:Write(tonumber(value) == 1 and \"${6:POWER ON}\\r\" or \"${7:POWER OFF}\\r\")",
      "        end",
      "    end",
      "end",
      "",
      "NamedControl.SubscribeText(\"${2:IPAddress}\")",
      "NamedControl.SubscribeText(\"${4:Power}\")",
      "",
      "-- Wait for the device's control IP before connecting",
      "function StartupTimerClick()",
      "    local localIp = Device.LocalUnit.ControlIP",
      "    if localIp ~= nil and localIp ~= \"0.0.0.0\" then",
      "        StartupTimer:Stop()",
      "        Connect()",
      "    end",
      "end",
      "",
      "StartupTimer = Timer.New()",
      "StartupTimer.EventHandler = StartupTimerClick",
      "StartupTimer:Start(0.5)"
    ],
    "description": "Starting point for a 3rd-party TCP control driver: IP from a Control Panel control, connection status LED, subscribed controls and line-based feedback parsing."
  }
